# Drizzle — local PostgreSQL
# No surrounding quotes on DATABASE_URL (Docker --env-file keeps literal " marks and breaks parsing).
# If the password contains @, encode it as %40 (e.g. secret@123 → secret%40123).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/employee_portal

# Shared Better Auth DB (defaults to DATABASE_URL). PHH-DRIVE uses the same URL.
# AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5432/employee_portal

# --- Public URLs (local dev) ---
ORIGIN=http://portal.local.test
DRIVE_ORIGIN=http://drive.local.test
DOCS_ORIGIN=http://docs.local.test
OAI_ORDER_SENDER_ORIGIN=http://oai-order-sender.local.test
N8N_CHATBOT_ORIGIN=http://chatbot.local.test
N8N_MONITOR_ORIGIN=http://monitor.local.test
PHH_CALLTRACKER_DASHBOARD_ORIGIN=http://dashboardroutetracker.local.test
QMS_ORIGIN=http://qmsdashboard.local.test
BED_STATUS_MANAGER_ORIGIN=http://bed-status.local.test
# Server-side drive API URL when DRIVE_ORIGIN is not reachable from the container (Docker).
# Use http:// to the container — TLS terminates at nginx. https://phh-drive:1025 causes SSL "wrong version number".
# DRIVE_INTERNAL_ORIGIN=http://host.docker.internal:1025
# DRIVE_INTERNAL_ORIGIN=http://phh-drive:1025
# Team API key for portal media uploads (server-side only; znltv_… with drive.read/write/share)
# DRIVE_TEAM_API_KEY=znltv_...
# DRIVE_STORAGE_PROVIDER=local
# Max request body for drive media uploads (installers, ZIPs). Docker default: 1000M
# BODY_SIZE_LIMIT=1000M
AUTH_COOKIE_DOMAIN=.local.test
# Optional override; sibling *_ORIGIN values (incl. QMS_ORIGIN) are trusted by default for ?redirectTo=
# PORTAL_TRUSTED_REDIRECT_ORIGINS=http://drive.local.test,http://docs.local.test,http://chatbot.local.test,http://qmsdashboard.local.test

# --- Public URLs (production) ---
# ORIGIN=https://phh.com
# DRIVE_ORIGIN=https://drive.phh.com
# DOCS_ORIGIN=https://docs.phh.com
# OAI_ORDER_SENDER_ORIGIN=https://ordersenderoai.phh.com
# N8N_CHATBOT_ORIGIN=https://chatbotn8n.phh.com
# N8N_MONITOR_ORIGIN=https://monitorn8n.phh.com
# PHH_CALLTRACKER_DASHBOARD_ORIGIN=https://dashboardroutetracker.phh.com
# QMS_ORIGIN=https://qmsdashboard.phh.com
# BED_STATUS_MANAGER_ORIGIN=https://bedstatus.phh.com
# DRIVE_INTERNAL_ORIGIN=http://phh-drive:1025
# DRIVE_STORAGE_PROVIDER=tigris
# AUTH_COOKIE_DOMAIN=.phh.com
# PORTAL_TRUSTED_REDIRECT_ORIGINS=https://drive.phh.com,https://docs.phh.com,https://chatbotn8n.phh.com,https://qmsdashboard.phh.com

# Caddy reverse proxy (employee-portal generates Caddyfile.generated from ORIGIN + DRIVE_ORIGIN + DOCS_ORIGIN)
# CADDY_PORTAL_UPSTREAM=localhost:1027
# CADDY_DRIVE_UPSTREAM=localhost:1025
# CADDY_DOCS_UPSTREAM=localhost:1026
# CADDY_OAI_ORDER_SENDER_UPSTREAM=localhost:6002
# CADDY_BED_STATUS_MANAGER_UPSTREAM=localhost:6005
# CADDY_QMS_UPSTREAM=localhost:1028
# CADDY_TLS=auto   # force HTTPS blocks (default: infer from ORIGIN/DRIVE_ORIGIN scheme)
# CADDY_TLS=off    # force HTTP blocks (local dev)

# Vite dev server allowlist (optional; defaults to AUTH_COOKIE_DOMAIN or ORIGIN hostnames)
# ALLOWED_HOSTS=.phh.com

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Session lifetime and cookies (optional — SSO defaults: 7d expiry, 30m rolling refresh; cookie cache off for instant role revoke)
# AUTH_SESSION_EXPIRES_IN="7d"
# AUTH_SESSION_UPDATE_AGE="30m"
# AUTH_SESSION_COOKIE_CACHE_ENABLED="false"
# AUTH_SESSION_COOKIE_CACHE_MAX_AGE="30m"
# AUTH_SESSION_SECURE_COOKIES="true"
# SMTP (auth emails: OTP, password reset, invites)
# Office 365: smtp.office365.com:587 — mailbox must have Authenticated SMTP enabled.
# SMTP_USER and the address inside SMTP_FROM must be the SAME mailbox (e.g. ict@punhlainghospitals.com).
# Gmail may receive mail while @punhlainghospitals.com does not: check Exchange quarantine / junk / transport rules.
# If login fails with "basic authentication is disabled", enable SMTP AUTH for the mailbox (Exchange admin).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Employee Portal <ict@punhlainghospitals.com>"
